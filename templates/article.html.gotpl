{{/* gotype: chameth.com/chameth.com/templates.ArticleData*/}}
{{define "content"}}
    <article class="h-entry">
        <header>
            <h2 class="p-name">{{ .ArticleTitle }}</h2>
            <p class="date">Published on
                <time class="dt-published" datetime="{{ .ArticleDate.Iso }}">{{ .ArticleDate.Friendly }}</time>
                {{if and .Admin .EditLink}}&middot; <a href="{{.EditLink}}">Edit</a>{{end}}
            </p>
        </header>

        {{ if .ArticleDate.ShowWarning -}}
            <aside class="old-post-warning raised-box">
                <p>
                    Warning: this post is over {{ .ArticleDate.YearsOld }} years old and might be out of date.
                    Technology, society and my opinions may have shifted in the time since.
                    Instructions may no longer make sense, software may no longer be available, etc.
                    Caveat lector.
                </p>
            </aside>
        {{- end }}

        <div class="e-content">
            {{block "article" .}}{{end}}
        </div>

        {{call .Component "syndication"}}

        {{call .Component "nod"}}

        {{call .Component "contact" "Have thoughts that transcend nodding? Send me a message!"}}

        {{ if .RelatedPosts -}}
            <section class="post-links-parent">
                <h3>Related posts</h3>
                {{ if .FeedBuilderURL -}}
                    <p>
                        Here are some semantically similar posts. Want to subscribe using a feed reader?
                        You can <a href="{{ .FeedBuilderURL }}">build a feed</a> with just posts similar to this one.
                        <a href="/feeds/">Standard feeds</a> are also available, but are approximately 42% less fun.
                    </p>
                {{- end }}
                <div class="post-links">
                {{ range .RelatedPosts -}}
                    {{call $.Component "postlink" .}}
                {{ end }}
                </div>
            </section>
        {{- end }}

        <section hidden>
            <section class="h-card p-author" hidden="hidden">
                <a class="p-name u-url" href="{{ .PageData.SiteURL }}/">Chris Smith</a>
                <img class="u-photo" src="{{ .PageData.SiteURL }}/avatar.webp">
                <span class="p-nickname">MD87</span>
                #nobridge
            </section>

            <a class="u-url u-uid" href="{{ .PageData.CanonicalUrl }}"></a>

            <p class="p-summary">
                {{ .ArticleSummary }}
            </p>
        </section>
    </article>

    <script type="application/javascript" nonce="littlefoot-ae805b14">
        document.addEventListener('DOMContentLoaded', () => {
            const hasNotes = document.querySelector('.marginnote') !== null;
            const lists = document.querySelectorAll('.e-content > .footnotes');
            const wide = matchMedia('(width >= 1420px)');
            let popovers = null;

            const retarget = (from, to) => {
                document.querySelectorAll(`a.footnote-ref[href^="#${from}:"]`).forEach((a) => {
                    a.setAttribute('href', `#${to}:` + a.getAttribute('href').slice(from.length + 2));
                });
            };

            // Wide layouts show footnotes as notes in the margin, so hide the
            // footnote list and point the references at the notes. Otherwise use
            // the list, with littlefoot popovers. Re-run whenever the layout flips.
            const update = () => {
                if (hasNotes && wide.matches) {
                    popovers?.unmount();
                    popovers = null;
                    lists.forEach((list) => list.hidden = true);
                    retarget('fn', 'mn');
                } else {
                    retarget('mn', 'fn');
                    lists.forEach((list) => list.hidden = false);
                    popovers ??= littlefoot.littlefoot({
                        activateDelay: 0,
                        buttonTemplate: `<sup id="fnref:<% number %>" class="footnote-ref"><a href="#fn:<% number %>" role="doc-noteref"><% number %></a></sup>`,
                    });
                }
            };

            update();
            wide.addEventListener('change', update);
        });
    </script>
{{end}}
