{{/* gotype: chameth.com/chameth.com/features/posts/link.Data*/}}
<a class="post-link raised-box plain-link" href="{{.Url}}">
  <article>
    <div class="img-holder">
      {{- if .Images }}
      <picture>
        {{- range .Images -}}
        <source srcset="{{ .Url }}" type="{{ .ContentType }}">
        {{- end -}}
        <img src="{{ (index .Images 0).Url }}" alt="{{ .Alt }}">
      </picture>
      {{- else -}}
      <div aria-hidden="true" class="placeholder">
        <div>
          ????????????<br>
          ?????????<span>?</span>??????<br>
          ????????????<br>
          ??????????????<br>
        </div>
      </div>
      {{ end -}}
    </div>
    <time class="post-date" datetime="{{ .Date.Format "2006-01-02" }}">{{ .Date.Format "Jan 2, 2006" }}</time>
    <h3 class="plain-header">{{ .Title }}</h3>
    <p>{{ .Summary }}</p>
  </article>
</a>