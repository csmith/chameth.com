 {{/* gotype: chameth.com/chameth.com/features/films/templates.FilmData*/}}
{{define "content"}}
    <article class="film-page">
        <header class="film-hero">
            {{if .PosterPath}}
            <img src="{{.PosterPath}}" alt="" class="film-backdrop">
            {{end}}
            <div class="film-details">
                {{if .PosterPath}}
                <img src="{{.PosterPath}}" alt="{{.FilmTitle}} poster" class="film-poster">
                {{end}}
                <p class="film-breadcrumb"><a href="/films/">Films</a> &raquo;</p>
                <h2 class="plain-header">{{.FilmTitle}}{{if .Year}} <time class="film-year" datetime="{{.Year}}">{{.Year}}</time>{{end}}</h2>
                <div class="film-overview">{{.Overview}}</div>
            </div>
            <div class="film-summary">
                {{if .TimesWatched}}
                <p>
                    <span>Logged: {{if eq .TimesWatched 1}}once{{else if eq .TimesWatched 2}}twice{{else}}{{.TimesWatched}} times{{end}}.</span>
                    <span>{{if gt .TimesWatched 1}}Average rating{{else}}Rating{{end}}: {{call .Component "rating" .AverageRating}}.</span>
                    {{if .Ranking}}<span>Ranking: <a href="{{.RankingPath}}">{{.Ranking}}/{{.RankingTotal}}</a>.</span>{{end}}
                </p>
                {{end}}
                {{if .TMDBID}}
                <p class="film-links">
                    <a href="https://www.themoviedb.org/movie/{{.TMDBID}}">TMDB</a>
                    <a href="https://letterboxd.com/tmdb/{{.TMDBID}}">Letterboxd</a>
                </p>
                {{end}}
            </div>
        </header>

        <div class="film-reviews">
            {{range .Reviews}}
            <section class="h-review">
                <h3>Watched on <time class="dt-published" datetime="{{.WatchedDate.Format "2006-01-02"}}">{{.WatchedDate.Format "2 Jan 2006"}}</time></h3>
                {{if or (gt $.TimesWatched 1) .IsRewatch .HasSpoilers}}
                <p class="film-review-meta">
                    {{if gt $.TimesWatched 1}}{{call $.Component "rating" .Rating}}{{end}}
                    {{if .IsRewatch}}<span class="film-rewatch">Rewatch</span>{{end}}
                    {{if .HasSpoilers}}<span class="film-spoilers">Spoilers</span>{{end}}
                </p>
                {{end}}
                {{if .Content}}
                <div class="e-content">
                    {{.Content}}
                </div>
                {{else}}
                <p class="film-no-review">No review.</p>
                {{end}}
                <div hidden>
                    <data class="p-rating" value="{{.Rating}}"></data>
                    <data class="p-worst" value="1"></data>
                    <data class="p-best" value="10"></data>
                </div>
            </section>
            {{end}}
            {{if .FilmLists}}
            <section class="film-lists">
                <h3>Listed in</h3>
                {{range .FilmLists}}
                    {{call $.Component "filmlist" .}}
                {{end}}
            </section>
            {{end}}
            {{.Syndications}}
        </div>
    </article>

    {{call .Component "nod"}}
{{end}}
