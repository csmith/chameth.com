{{/* gotype: chameth.com/chameth.com/features/sitemap.SiteMapData*/}}<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {{ range .Pages -}}
        <url>
            <loc>{{ $.SiteURL }}{{ .Path }}</loc>
            <changefreq>{{ .Frequency }}</changefreq>
            <priority>{{ .Priority }}</priority>
        </url>
    {{- end }}

    <url>
        <loc>{{ .SiteURL }}/index.xml</loc>
        <changefreq>weekly</changefreq>
        <priority>0.5</priority>
    </url>

    <url>
        <loc>{{ .SiteURL }}/short.xml</loc>
        <changefreq>weekly</changefreq>
        <priority>0.25</priority>
    </url>

    <url>
        <loc>{{ .SiteURL }}/long.xml</loc>
        <changefreq>weekly</changefreq>
        <priority>0.25</priority>
    </url>

    <url>
        <loc>{{ .SiteURL }}/snippets/feed.xml</loc>
        <changefreq>weekly</changefreq>
        <priority>0.25</priority>
    </url>

    <url>
        <loc>{{ .SiteURL }}/poems/feed.xml</loc>
        <changefreq>weekly</changefreq>
        <priority>0.25</priority>
    </url>

    <url>
        <loc>{{ .SiteURL }}/films/reviews/feed.xml</loc>
        <changefreq>weekly</changefreq>
        <priority>0.25</priority>
    </url>

    {{ range .Posts -}}
        <url>
            <loc>{{ $.SiteURL }}{{ .Path }}</loc>
            <changefreq>never</changefreq>
            <priority>0.9</priority>
            <lastmod>{{ .Date.Iso }}</lastmod>
        </url>
    {{- end }}

    {{ range .Snippets -}}
        <url>
            <loc>{{ $.SiteURL }}{{ .Path }}</loc>
            <changefreq>yearly</changefreq>
            <priority>0.4</priority>
        </url>
    {{- end }}

    {{ range .Poems -}}
        <url>
            <loc>{{ $.SiteURL }}{{ .Path }}</loc>
            <changefreq>never</changefreq>
            <priority>0.4</priority>
            <lastmod>{{ .Date.Iso }}</lastmod>
        </url>
    {{- end }}

    {{ range .Films -}}
        <url>
            <loc>{{ $.SiteURL }}{{ .Path }}</loc>
            <changefreq>yearly</changefreq>
            <priority>0.2</priority>
            <lastmod>{{ .Date.Iso }}</lastmod>
        </url>
    {{- end }}

    {{ range .FilmLists -}}
        <url>
            <loc>{{ $.SiteURL }}{{ .Path }}</loc>
            <changefreq>monthly</changefreq>
            <priority>0.1</priority>
        </url>
    {{- end }}
</urlset>
