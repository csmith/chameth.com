{{/* gotype: chameth.com/chameth.com/features/contact.statsData */}}
{{define "content"}}
    <h2>Contact form rejections</h2>
    {{if .Rows}}
    <table class="check-matrix">
        <thead>
            <tr>
                <th></th>
                {{range .Checks}}<th scope="col">{{.}}</th>{{end}}
            </tr>
        </thead>
        <tbody>
            {{range .Rows}}
            <tr>
                <th scope="row">{{.Check}}</th>
                {{range .Cells}}<td class="heat-{{.Heat}}">{{.Count}}</td>{{end}}
            </tr>
            {{end}}
        </tbody>
    </table>
    {{else}}
    <p>No rejections.</p>
    {{end}}
{{end}}
